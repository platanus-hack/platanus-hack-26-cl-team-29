DATABASE_URL=postgres://localhost:5432/app

# WhatsApp vía Kapso (server/whatsapp). Sin API key / phone id, los envíos solo se loguean.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# El mismo secreto configurado en el webhook de Kapso. Sin él, el webhook responde 503.
KAPSO_WEBHOOK_SECRET=
# Plantilla aprobada por Meta para avisar fuera de la ventana de 24 h (no funciona en el sandbox).
# Sin ella, los mensajes fuera de la ventana esperan a que la persona vuelva a escribir.
KAPSO_TEMPLATE_NAME=
KAPSO_TEMPLATE_LANGUAGE=es

# Llave con que se cifran el certificado y los CAF que el proveedor sube desde el panel ("Conectar mi SII").
# 32 bytes en base64: `openssl rand -base64 32`. Sin ella el panel no guarda nada. Si cambia, hay que volver a conectar.
# También cifra la sesión del portal del SII guardada en Postgres (tabla sii_portal_sesion): sin llave o sin
# DATABASE_URL la sesión queda en memoria y cada reinicio cuesta un login del cupo de sesiones del SII.
SII_LLAVE_CIFRADO=

# El SII se configura SOLO desde el panel del proveedor ("Conectar mi SII"): certificado, empresa, resolución y CAF
# quedan cifrados en Postgres con SII_LLAVE_CIFRADO. El servidor no lee variables SII_* (sin conexión, SII falso).
# Los scripts de scripts/ (sii-humo.ts, sii-folio.ts) leen sus credenciales de un .env local al correrlos; ver su encabezado.

# Capa de IA (server/ia): sin clave, el agente de WhatsApp interpreta con reglas fijas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Mercado Público (server/mercado-publico): proveedores y precios de referencia de alimentos e insumos.
# Sin ticket se usa solo el dataset OCDS anual de ChileCompra (sin las órdenes de los últimos días); sin red, órdenes de ejemplo.
# El ticket se pide en https://api.mercadopublico.cl (10.000 consultas diarias por ticket).
MERCADO_PUBLICO_TICKET=
# Cada cuántas horas se vuelve a consultar (6 por defecto). MERCADO_PUBLICO=0 apaga las consultas.
MERCADO_PUBLICO_INTERVALO_HORAS=
