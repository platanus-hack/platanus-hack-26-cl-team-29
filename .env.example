DATABASE_URL=postgres://localhost:5432/app

# WhatsApp vía Kapso (server/whatsapp). Sin API key / phone id, los envíos solo se loguean.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# El mismo secreto configurado en el webhook de Kapso. Sin él, el webhook responde 503.
KAPSO_WEBHOOK_SECRET=
# Plantilla aprobada por Meta para avisar fuera de la ventana de 24 h (no funciona en el sandbox).
# Sin ella, los mensajes fuera de la ventana esperan a que la persona vuelva a escribir.
KAPSO_TEMPLATE_NAME=
KAPSO_TEMPLATE_LANGUAGE=es

# Llave con que se cifran el certificado y los CAF que el proveedor sube desde el panel ("Conectar mi SII").
# 32 bytes en base64: `openssl rand -base64 32`. Sin ella el panel no guarda nada. Si cambia, hay que volver a conectar.
SII_LLAVE_CIFRADO=

# SII, solo ambiente de certificación (server/sii). Respaldo de la conexión hecha desde el panel: si ambas existen,
# gana la del panel. Sin ninguna se usa una implementación falsa en memoria.
# Certificado digital del firmante (.pfx en base64) y su clave. Su titular es el RutEnvia de los sobres.
SII_PFX_BASE64=
SII_PFX_CLAVE=
# Empresa emisora y fecha de su resolución de certificación (AAAA-MM-DD).
SII_RUT_EMISOR=
SII_FCH_RESOL=
SII_EMISOR_RAZON_SOCIAL=
SII_EMISOR_GIRO=
SII_EMISOR_ACTECO=
SII_EMISOR_DIRECCION=
SII_EMISOR_COMUNA=
SII_EMISOR_CIUDAD=
# CAF de certificación por tipo (el XML descargado del SII, en base64): factura, guía y nota de crédito.
SII_CAF_33_BASE64=
SII_CAF_52_BASE64=
SII_CAF_61_BASE64=
# Opcional: primer folio a usar de cada CAF si ya tiene folios usados fuera de esta app.
SII_FOLIO_DESDE_33=
SII_FOLIO_DESDE_52=
SII_FOLIO_DESDE_61=
# Receptor de la prueba de humo (scripts/sii-humo.ts).
SII_RUT_RECEPTOR=
SII_RECEPTOR_RAZON_SOCIAL=
SII_RECEPTOR_GIRO=
SII_RECEPTOR_DIRECCION=
SII_RECEPTOR_COMUNA=
